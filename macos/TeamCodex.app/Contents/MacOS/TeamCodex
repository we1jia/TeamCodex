#!/bin/bash
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
if [[ -f "$here/../../../macos/launch.sh" ]]; then
  exec /bin/bash "$here/../../../macos/launch.sh"
elif [[ -f "$here/../../launch.sh" ]]; then
  exec /bin/bash "$here/../../launch.sh"
elif [[ -f "$here/../../../launch.sh" ]]; then
  exec /bin/bash "$here/../../../launch.sh"
elif [[ -f "$here/launch.sh" ]]; then
  exec /bin/bash "$here/launch.sh"
else
  /usr/bin/osascript -e 'display dialog "无法找到 launch.sh 启动脚本，请确认 TeamCodex 目录完整。" buttons {"确定"} default button 1 with icon stop with title "TeamCodex"'
  exit 1
fi
